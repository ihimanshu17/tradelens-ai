# Google Gemini API Key (Required for live AI reasoning; if omitted, intelligent mock reasoning is used)
GEMINI_API_KEY=

# Preferred Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL Connection String (e.g. Neon Postgres)
# If left empty, TradeLens AI seamlessly uses an in-memory/local repository fallback for instant local evaluation.
DATABASE_URL=
